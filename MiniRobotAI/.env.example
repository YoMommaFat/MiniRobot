# ============================================================================
# MiniRobot AI - Környezeti változók példa fájl (.env.example)
# ============================================================================
# Használat:
#   1. Másold le ezt a fájlt .env néven:
#      cp .env.example .env
#   2. Írd be a saját API kulcsaidat az alábbi mezőkbe.
# ============================================================================

# Google Gemini API kulcs (a központi LLM Agyhoz - agent.py)
# Szerezd be itt: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="AIzaSy_YOUR_GOOGLE_API_KEY_HERE"

# Groq API kulcs és végpont (a felhős Whisper beszédfelismeréshez - asr_node.py)
# Szerezd be itt: https://console.groq.com/keys
OPENAI_API_KEY="gsk_YOUR_GROQ_API_KEY_HERE"
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
